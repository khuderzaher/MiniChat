def _re_search_eq(text):
    """يبحث عن معادلة خطية في النص."""
    import re as _r
    m = _r.search(r"(-?\d*[a-zA-Z]\s*[+-]?\s*\d*\s*=\s*-?\d+)", text)
    if m:
        return m.group(1).replace(" ", "")
    return None

def _re_search_expr(text):
    """يبحث عن تعبير رياضي بسيط."""
    import re as _r
    m = _r.search(r"(-?\d+(?:\s*[+\-*/×÷]\s*\d+)+)", text)
    if m:
        return m.group(1)
    return None



